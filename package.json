{
  "name": "lightsail",
  "version": "1.0.0",
  "private": true,
  "description": "Web UI to provision a Lightsail Ubuntu instance via AWS CLI",
  "scripts": {
    "start": "python3 backend/server.py",
    "dev": "python3 backend/server.py",
    "create": "python3 backend/create_instance.py",
    "cleanup": "python3 backend/cleanup_instance.py",
    "ios": "open ios/Lightsail.xcodeproj",
    "bot": "python3 telegram/bot.py",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2"
  },
  "engines": {
    "node": ">=20"
  }
}
